aspect Types {
public:
    synthetic const char* Type::display_name() const => this->name(); 
    synthetic bool Type::is_unknown() const => false;

    synthetic const char* IntType::display_name() const => "Type";
    synthetic const char* UnknownType::display_name() const => "!UNKNOWN!";

    synthetic const char* UnknownType::is_unknown() const => true;
};
