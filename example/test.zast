abstract Stmt;

abstract Expr;

IdUse  : Expr ::= <ID>;

// Arithmetic
UnaryExpr   : Expr ::= Expr;

BinaryExpr  : Expr ::= Lhs:Expr Rhs:Expr;

BinaryExpr2 : BinaryExpr ::= Incredible2:<ID>;

BinaryExpr3 : BinaryExpr2;

BinaryExpr4 : BinaryExpr3 ::= Incredible4:<ID>;

VarStmt     : Stmt ::= Variable:IdDecl;
BlockStmt   : Stmt ::= Stmt*;

IfStmt      : Stmt ::= Cond:Expr Then:Stmt [Else:Stmt];

abstract Type;
IntType     : Type;
UnknownType : Type;

FuncDecl ::= FuncName:IdDecl [ReturnType:Type] Arg:IdDecl* Line:Stmt*;

IdDecl ::= <ID>; 

Program ::= FuncDecl*;
