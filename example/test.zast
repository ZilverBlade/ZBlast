abstract Stmt;

abstract Expr;

IdDecl ::= <ID>;
IdUse  : Expr ::= <ID>;

// Arithmetic
BinaryExpr  : Expr ::= Lhs:Expr Rhs:Expr;
UnaryExpr   : Expr ::= Expr;

VarStmt     : Stmt ::= Variable:IdDecl;
BlockStmt   : Stmt ::= Stmt*;

IfStmt      : Stmt ::= Cond:Expr Then:Stmt [Else:Stmt];

abstract Type;
IntType     : Type;
UnknownType : Type;

FuncDecl ::= FuncName:IdDecl [ReturnType:Type] Arg:IdDecl* Line:Stmt*;

Program ::= FuncDecl*;
